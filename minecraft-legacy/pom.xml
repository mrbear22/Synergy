<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent><groupId>archi.quest</groupId><artifactId>synergy-parent</artifactId><version>1.6.0</version></parent>
	<artifactId>synergy-minecraft-legacy</artifactId>
	<packaging>pom</packaging>
	<description>Obfuscated Minecraft 1.21.1 server + Fabric API remapped to Mojang names, to compile against (never redistributed)</description>

	<properties>
		<minecraft.version>1.21.1</minecraft.version>
		<minecraft.server.url>https://piston-data.mojang.com/v1/objects/59353fb40c36d304f2035d51e7d6e6baa98dc05c/server.jar</minecraft.server.url>
		<minecraft.mappings.url>https://piston-data.mojang.com/v1/objects/03f8985492bda0afc0898465341eb0acef35f570/server.txt</minecraft.mappings.url>
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.install.skip>true</maven.install.skip>
	</properties>

	<repositories>
		<repository><id>fabric</id><url>https://maven.fabricmc.net/</url></repository>
	</repositories>

	<dependencies>
		<dependency><groupId>net.fabricmc</groupId><artifactId>tiny-remapper</artifactId><version>0.15.0</version><scope>provided</scope></dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>com.googlecode.maven-download-plugin</groupId>
				<artifactId>download-maven-plugin</artifactId>
				<version>1.13.0</version>
				<executions>
					<execution>
						<id>server</id>
						<phase>generate-resources</phase>
						<goals><goal>wget</goal></goals>
						<configuration>
							<uri>${minecraft.server.url}</uri>
							<outputDirectory>${project.build.directory}/bundler</outputDirectory>
							<outputFileName>server-bundler-${minecraft.version}.jar</outputFileName>
							<unpack>true</unpack>
						</configuration>
					</execution>
					<execution>
						<id>mappings</id>
						<phase>generate-resources</phase>
						<goals><goal>wget</goal></goals>
						<configuration>
							<uri>${minecraft.mappings.url}</uri>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<outputFileName>server-${minecraft.version}.txt</outputFileName>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>intermediary</id>
						<phase>generate-resources</phase>
						<goals><goal>unpack</goal></goals>
						<configuration>
							<artifactItems><artifactItem><groupId>net.fabricmc</groupId><artifactId>intermediary</artifactId><version>${minecraft.version}</version><classifier>v2</classifier></artifactItem></artifactItems>
							<includes>mappings/mappings.tiny</includes>
							<outputDirectory>${project.build.directory}/intermediary</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>fabric-api</id>
						<phase>generate-resources</phase>
						<goals><goal>copy</goal></goals>
						<configuration>
							<artifactItems>
								<artifactItem><groupId>net.fabricmc.fabric-api</groupId><artifactId>fabric-api-base</artifactId><version>0.4.42+6573ed8c19</version></artifactItem>
								<artifactItem><groupId>net.fabricmc.fabric-api</groupId><artifactId>fabric-lifecycle-events-v1</artifactId><version>2.6.0+0865547519</version></artifactItem>
								<artifactItem><groupId>net.fabricmc.fabric-api</groupId><artifactId>fabric-networking-api-v1</artifactId><version>4.3.1+d30f6a7919</version></artifactItem>
								<artifactItem><groupId>net.fabricmc.fabric-api</groupId><artifactId>fabric-message-api-v1</artifactId><version>6.0.14+8aaf3aca19</version></artifactItem>
								<artifactItem><groupId>me.lucko</groupId><artifactId>fabric-permissions-api</artifactId><version>0.3.1</version></artifactItem>
							</artifactItems>
							<outputDirectory>${project.build.directory}/api</outputDirectory>
							<stripVersion>true</stripVersion>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<phase>process-resources</phase>
						<goals><goal>exec</goal></goals>
						<configuration>
							<executable>${java.home}/bin/java</executable>
							<classpathScope>compile</classpathScope>
							<arguments>
								<argument>-classpath</argument><classpath/>
								<argument>${project.basedir}/Remap.java</argument>
								<argument>named</argument>
								<argument>${project.build.directory}/intermediary/mappings/mappings.tiny</argument>
								<argument>${project.build.directory}/server-${minecraft.version}.txt</argument>
								<argument>${project.build.directory}/bundler/META-INF/versions/${minecraft.version}/server-${minecraft.version}.jar</argument>
								<argument>${project.build.directory}/minecraft-${minecraft.version}-named.jar</argument>
								<argument>${project.build.directory}/api/fabric-api-base.jar</argument>
								<argument>${project.build.directory}/api/fabric-lifecycle-events-v1.jar</argument>
								<argument>${project.build.directory}/api/fabric-networking-api-v1.jar</argument>
								<argument>${project.build.directory}/api/fabric-message-api-v1.jar</argument>
								<argument>${project.build.directory}/api/fabric-permissions-api.jar</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals><goal>attach-artifact</goal></goals>
						<configuration>
							<artifacts><artifact><file>${project.build.directory}/minecraft-${minecraft.version}-named.jar</file><type>jar</type></artifact></artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
