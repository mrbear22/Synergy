<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>synergy-parent</artifactId>
    <groupId>archi.quest</groupId>
    <version>1.6.0</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>synergy</artifactId>
  <name>Synergy</name>
  <version>1.6.0</version>
  <description>Basic tools and server messaging plugin</description>
  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>plugin.yml</include>
          <include>bungee.yml</include>
          <include>velocity-plugin.json</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>steve.png</include>
        </includes>
      </resource>
    </resources>
    <finalName>Synergy</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <minimizeJar>false</minimizeJar>
          <artifactSet>
            <excludes>
              <exclude>com.google.code.gson:gson</exclude>
              <exclude>org.jspecify:jspecify</exclude>
              <exclude>club.minnced:opus-java*</exclude>
              <exclude>net.java.dev.jna:*</exclude>
            </excludes>
          </artifactSet>
          <relocations>
            <relocation>
              <pattern>com.google.protobuf</pattern>
              <shadedPattern>me.synergy.shaded.protobuf</shadedPattern>
            </relocation>
            <relocation>
              <pattern>io.github.jwdeveloper.tiktok</pattern>
              <shadedPattern>me.synergy.shaded.tiktok</shadedPattern>
            </relocation>
            <relocation>
              <pattern>org.apache.commons</pattern>
              <shadedPattern>me.synergy.shaded.commons</shadedPattern>
            </relocation>
          </relocations>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>META-INF/*.SF</exclude>
                <exclude>META-INF/*.DSA</exclude>
                <exclude>META-INF/*.RSA</exclude>
              </excludes>
            </filter>
            <filter>
              <artifact>archi.quest:synergy-fabric</artifact>
              <excludes>
                <exclude>fabric.mod.json</exclude>
              </excludes>
            </filter>
          </filters>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>fabric</id>
      <dependencies>
        <dependency>
          <groupId>archi.quest</groupId>
          <artifactId>synergy-fabric</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>33.3.1-jre</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.luckperms</groupId>
      <artifactId>api</artifactId>
      <version>5.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.skinsrestorer</groupId>
      <artifactId>skinsrestorer-api</artifactId>
      <version>15.0.3</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.github.plan-player-analytics</groupId>
      <artifactId>Plan</artifactId>
      <version>5.6.2883</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
